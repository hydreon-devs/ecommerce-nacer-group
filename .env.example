# Variables server-only del panel de administración (specs/002_mvp_panel_administracion).
# Ninguna lleva prefijo NEXT_PUBLIC_: el panel no necesita ejecutar Supabase en el navegador.
# Copiar a .env.local (ya cubierto por .gitignore) y completar con valores reales.

# https://supabase.com/dashboard/project/pbjwbozxpzqqtheatxsi/settings/api
SUPABASE_URL=https://pbjwbozxpzqqtheatxsi.supabase.co

# Llave "anon"/"publishable" del mismo panel de API. No es secreta, pero tampoco se expone
# al cliente: solo la usa lib/supabase/auth-server.ts para verificar sesión.
SUPABASE_ANON_KEY=

# Llave "service_role" del mismo panel de API — SECRETA. Ninguna herramienta de MCP la
# expone; se copia a mano desde el dashboard. Nunca debe llegar a un componente cliente ni
# a un log. La usa exclusivamente lib/supabase/admin-client.ts.
SUPABASE_SERVICE_ROLE_KEY=
